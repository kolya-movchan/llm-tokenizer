---
import Layout from "../layouts/Layout.astro";
import { getSEOProps, locales } from "../config/seo";

// Get SEO props for the default locale
const seoProps = getSEOProps("404", locales[0]);
---

<Layout {...seoProps} lang={locales[0]}>
  <main
    class="flex flex-col items-center justify-center min-h-[60vh] px-4 text-center"
  >
    <h1 class="text-6xl font-bold mb-4">404</h1>
    <h2 class="text-2xl mb-6">Page Not Found</h2>
    <p class="text-gray-600 mb-8">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a
      href="/"
      class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
    >
      Return Home
    </a>
  </main>
</Layout>
