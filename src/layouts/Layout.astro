---
import SEO from "../components/SEO.astro";
import { defaultLocale, type Locale } from "../config/seo";
import "../styles/reset.css";

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  hreflangs?: Array<{
    lang: Locale;
    url: string;
  }>;
  ogImage?: string;
  ogType?: string;
  twitterCard?: string;
  lang?: Locale;
}

const props: Props = Astro.props;
const locale = props.lang || defaultLocale;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO {...props} lang={locale} />
  </head>
  <body>
    <slot />
  </body>
</html>
